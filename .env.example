# TMDB API Read Access Token (v4 Bearer), jamais une clé v3.
TMDB_API_TOKEN=COLLER_ICI_LE_TOKEN_API_READ_ACCESS_V4

# Couverture rétroactive des dates de sortie initiale
LOOKBACK_DAYS=365
# Pages Discover par type et par pays (20 titres/page, maximum TMDB 500).
# Augmenter augmente la couverture et le nombre d'appels API.
MAX_PAGES_PER_TYPE_REGION=8
# Nombre de vérifications simultanées (rester bas pour limiter la charge API)
CONCURRENCY=3
# Historique visible des événements détectés
EVENT_HISTORY_DAYS=90
# Types d'offres inclus dans les catalogues : flatrate = abonnement ; free/ads = gratuit/avec pub.
MONETIZATION_TYPES=flatrate
